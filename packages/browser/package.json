{
  "name": "@codepress/interactions-browser",
  "version": "1.2.0",
  "description": "Privacy-first browser interaction evidence SDK: screen snapshots, click follow-through, UI checks and pluggable sinks",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./detect": {
      "import": {
        "types": "./dist/detect.d.ts",
        "default": "./dist/detect.js"
      },
      "require": {
        "types": "./dist/detect.d.cts",
        "default": "./dist/detect.cjs"
      }
    },
    "./page-script": {
      "import": {
        "types": "./dist/page-script.d.ts",
        "default": "./dist/page-script.js"
      },
      "require": {
        "types": "./dist/page-script.d.cts",
        "default": "./dist/page-script.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-page-script.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "pack:check": "node scripts/pack-check.mjs",
    "bench": "node scripts/overhead.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantfive/codepress-interactions.git",
    "directory": "packages/browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "telemetry",
    "layout",
    "snapshot",
    "interaction",
    "observability",
    "layout-checks"
  ],
  "typesVersions": {
    "*": {
      "detect": [
        "./dist/detect.d.ts"
      ],
      "page-script": [
        "./dist/page-script.d.ts"
      ]
    }
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
