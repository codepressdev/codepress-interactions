{
  "name": "@codepress/interactions-browser",
  "version": "0.2.0",
  "description": "Privacy-first browser interaction evidence SDK: screen snapshots, click follow-through and pluggable sinks",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quantfive/codepress-interactions.git",
    "directory": "packages/browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "telemetry",
    "layout",
    "snapshot",
    "interaction",
    "observability"
  ]
}
