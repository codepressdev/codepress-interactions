{
  "name": "@codepress/interactions-playwright",
  "version": "1.1.0",
  "description": "Playwright helpers that run the CodePress Interactions UI checks in tests: capture a snapshot, list findings, assert none",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external @playwright/test",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "dependencies": {
    "@codepress/interactions-browser": "workspace:^"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantfive/codepress-interactions.git",
    "directory": "packages/playwright"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "playwright",
    "layout",
    "testing",
    "ui-checks",
    "overlap"
  ]
}
