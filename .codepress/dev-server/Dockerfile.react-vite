# Generated by CodePress bootstrap-dev-server.
# Dev-mode image for the "react-vite" frontend (Live Dev Server).
# Edits are preserved, but running /codepress-bootstrap-dev-server again may overwrite them.
FROM public.ecr.aws/docker/library/node:26-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g --force pnpm@10.28.2
ENV PNPM_CONFIG_VIRTUAL_STORE_TYPE=project
WORKDIR /app

# The Live Dev Server hydrates app dependencies onto the mounted checkout.
ENV HOSTNAME=0.0.0.0 \
    CODEPRESS_BIND_HOST=0.0.0.0 \
    PORT=5173 \
    CODEPRESS_HMR_CLIENT_PORT=443 \
    CODEPRESS_HMR_PROTOCOL=wss \
    CODEPRESS_BASE_PATH=/

WORKDIR /app/examples/react-vite
EXPOSE 5173

ENV PATH="/app/examples/react-vite/node_modules/.bin:/app/node_modules/.bin:${PATH}"

CMD ["sh", "-c", "pnpm exec vite --host \"$CODEPRESS_BIND_HOST\" --port \"$PORT\" --strictPort"]
