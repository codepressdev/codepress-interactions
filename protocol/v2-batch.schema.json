{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quantfive/codepress-interactions/blob/main/protocol/v2-batch.schema.json",
  "title": "Batch",
  "description": "Protocol v2 event batch (POST /v2/batches). Retries reuse identical bytes and IDs. operation.* events require operation_id; ui.* and perf.* events cannot have one. No field carries page text, input values, HTML, URLs, queries or user IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "schema_version",
    "sdk_version",
    "events"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": 2
    },
    "sdk_version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z.+-]{1,64}$"
    },
    "release": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+:@/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/Event"
      }
    }
  },
  "$defs": {
    "Event": {
      "oneOf": [
        {
          "$ref": "#/$defs/LegacyEvent"
        },
        {
          "$ref": "#/$defs/SnapshotEvent"
        },
        {
          "$ref": "#/$defs/ClickSettledEvent"
        },
        {
          "$ref": "#/$defs/HoverSettledEvent"
        },
        {
          "$ref": "#/$defs/FindingEvent"
        },
        {
          "$ref": "#/$defs/PerfSummaryEvent"
        }
      ]
    },
    "LegacyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "schema_version",
        "source",
        "source_instance_id",
        "sequence",
        "occurred_at",
        "type",
        "attribution",
        "data"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "const": 2
        },
        "interaction_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "browser",
            "server",
            "worker"
          ]
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854776000
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "interaction.started",
            "ui.state.changed",
            "request.started",
            "request.completed",
            "operation.started",
            "operation.phase",
            "operation.completed",
            "capture.interrupted",
            "capture.events_dropped"
          ]
        },
        "attribution": {
          "type": "string",
          "enum": [
            "explicit",
            "inferred",
            "unknown"
          ]
        },
        "data": {
          "$ref": "#/$defs/LegacyData"
        }
      }
    },
    "SnapshotEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "schema_version",
        "source",
        "source_instance_id",
        "sequence",
        "occurred_at",
        "type",
        "attribution",
        "data"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "const": 2
        },
        "interaction_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "browser",
            "server",
            "worker"
          ]
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854776000
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "ui.snapshot"
        },
        "attribution": {
          "const": "unknown"
        },
        "data": {
          "$ref": "#/$defs/SnapshotData"
        }
      }
    },
    "ClickSettledEvent": {
      "type": "object",
      "additionalProperties": false,
