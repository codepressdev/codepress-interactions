{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quantfive/codepress-interactions/blob/main/protocol/v2-batch.schema.json",
  "title": "Batch",
  "description": "Protocol v2 event batch (POST /v2/batches). Retries reuse identical bytes and IDs. operation.* events require operation_id; ui.* and perf.* events cannot have one. No field carries page text, input values, HTML, URLs, queries or user IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "schema_version",
    "sdk_version",
    "events"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": 2
    },
    "sdk_version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z.+-]{1,64}$"
    },
    "release": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+:@/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/Event"
      }
    }
  },
  "$defs": {
    "Event": {
      "oneOf": [
        {
          "$ref": "#/$defs/LegacyEvent"
        },
        {
          "$ref": "#/$defs/SnapshotEvent"
        },
        {
          "$ref": "#/$defs/ClickSettledEvent"
        },
        {
          "$ref": "#/$defs/FindingEvent"
        },
        {
          "$ref": "#/$defs/PerfSummaryEvent"
        }
      ]
    },
    "LegacyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "schema_version",
        "source",
        "source_instance_id",
        "sequence",
        "occurred_at",
        "type",
        "attribution",
        "data"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "const": 2
        },
        "interaction_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "browser",
            "server",
            "worker"
          ]
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854776000
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "interaction.started",
            "ui.state.changed",
            "request.started",
            "request.completed",
            "operation.started",
            "operation.phase",
            "operation.completed",
            "capture.interrupted",
            "capture.events_dropped"
          ]
        },
        "attribution": {
          "type": "string",
          "enum": [
            "explicit",
            "inferred",
            "unknown"
          ]
        },
        "data": {
          "$ref": "#/$defs/LegacyData"
        }
      }
    },
    "SnapshotEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "schema_version",
        "source",
        "source_instance_id",
        "sequence",
        "occurred_at",
        "type",
        "attribution",
        "data"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "const": 2
        },
        "interaction_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "browser",
            "server",
            "worker"
          ]
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854776000
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "ui.snapshot"
        },
        "attribution": {
          "const": "unknown"
        },
        "data": {
          "$ref": "#/$defs/SnapshotData"
        }
      }
    },
    "ClickSettledEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "schema_version",
        "source",
        "source_instance_id",
        "sequence",
        "occurred_at",
        "type",
        "attribution",
        "data"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "const": 2
        },
        "interaction_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "browser",
            "server",
            "worker"
          ]
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854776000
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "ui.click.settled"
        },
        "attribution": {
          "const": "inferred"
        },
        "data": {
          "$ref": "#/$defs/ClickSettledData"
        }
      }
    },
    "FindingEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "schema_version",
        "source",
        "source_instance_id",
        "sequence",
        "occurred_at",
        "type",
        "attribution",
        "data"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "const": 2
        },
        "interaction_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "browser",
            "server",
            "worker"
          ]
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854776000
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "ui.finding"
        },
        "attribution": {
          "type": "string",
          "enum": [
            "inferred",
            "unknown"
          ]
        },
        "data": {
          "$ref": "#/$defs/FindingData"
        }
      }
    },
    "PerfSummaryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "schema_version",
        "source",
        "source_instance_id",
        "sequence",
        "occurred_at",
        "type",
        "attribution",
        "data"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "const": 2
        },
        "interaction_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "browser",
            "server",
            "worker"
          ]
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854776000
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "perf.summary"
        },
        "attribution": {
          "const": "unknown"
        },
        "data": {
          "$ref": "#/$defs/PerfSummaryData"
        }
      }
    },
    "LegacyData": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "control_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "surface": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "route_template": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "pattern": "^/[A-Za-z0-9_\\-./:{}\\[\\]*()+@~]{0,255}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "feedback_type": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "running",
                "succeeded",
                "failed",
                "cancelled",
                "pending",
                "completed",
                "error",
                "abandoned"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "request_label": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "v1 event data, unchanged except: sdk_version moved to the batch, and request_label (a bounded label returned by the host's requestLabel callback) was added."
    },
    "SnapshotData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "trigger",
        "route_template",
        "viewport_width",
        "viewport_height",
        "element_count",
        "truncated",
        "torn",
        "bytes",
        "walk_ms",
        "slices",
        "max_slice_ms"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the uncompressed snapshot body bytes; the body is stored at /v2/snapshots/{sha256}."
        },
        "trigger": {
          "type": "string",
          "enum": [
            "route",
            "click",
            "resize",
            "visible",
            "manual"
          ]
        },
        "route_template": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "pattern": "^/[A-Za-z0-9_\\-./:{}\\[\\]*()+@~]{0,255}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "viewport_width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "viewport_height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "element_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "truncated": {
          "type": "boolean"
        },
        "torn": {
          "type": "boolean"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "walk_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400000
        },
        "slices": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_slice_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400000
        }
      },
      "description": "A screen was captured. Sent once per distinct sha256 per page session."
    },
    "ClickSettledData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "control_id",
        "route_template",
        "first_feedback_ms",
        "settle_ms",
        "mutation_count",
        "request_count",
        "request_failed_count",
        "error_count",
        "long_task_count",
        "layout_shift_score",
        "route_changed",
        "dialog_opened",
        "focus_moved",
        "overlapped",
        "incomplete",
        "end_reason",
        "before_sha256",
        "after_sha256"
      ],
      "properties": {
        "action": {
          "const": "click"
        },
        "control_id": {
          "type": "string",
          "maxLength": 128
        },
        "route_template": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "pattern": "^/[A-Za-z0-9_\\-./:{}\\[\\]*()+@~]{0,255}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_feedback_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ],
          "description": "First DOM change, route change, dialog or focus move after the click; null when none was observed."
        },
        "settle_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400000,
          "description": "Time to the last observed effect when settled; otherwise time until the window ended."
        },
        "mutation_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "request_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "request_failed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "error_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "long_task_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when long tasks are unavailable in this browser."
        },
        "layout_shift_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when layout shifts are unavailable in this browser."
        },
        "route_changed": {
          "type": "boolean"
        },
        "dialog_opened": {
          "type": "boolean"
        },
        "focus_moved": {
          "type": "boolean"
        },
        "overlapped": {
          "type": "boolean",
          "description": "Another click started before this one settled (on both clicks). Counts are never shared between them."
        },
        "incomplete": {
          "type": "boolean",
          "description": "The window ended by timeout or by the page being hidden/unloaded."
        },
        "end_reason": {
          "type": "string",
          "enum": [
            "settled",
            "overlapped",
            "timeout",
            "page_hidden"
          ]
        },
        "before_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "after_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "What followed a click until the page was quiet for clickSettleMs with no observed request in flight. Always attribution \"inferred\"; interaction_id is the click's interaction.started id. Requests in the window are counted here and never marked explicit."
    },
    "FindingData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "check_version",
        "fingerprint",
        "route_template",
        "snapshot_sha256",
        "viewport_width",
        "viewport_height",
        "subject",
        "other",
        "evidence"
      ],
      "properties": {
        "check": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
          "description": "Check identifier, e.g. layout.text_overlap, hit.blocked, layout.clipped_text, click.no_feedback."
        },
        "check_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,64}$",
          "description": "Stable grouping key computed from check, route_template and element identity; never from text."
        },
        "route_template": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "pattern": "^/[A-Za-z0-9_\\-./:{}\\[\\]*()+@~]{0,255}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "viewport_width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "viewport_height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "tag",
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": -1,
              "maximum": 49999,
              "description": "Row in the snapshot's element columns; -1 when not in the snapshot."
            },
            "tag": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "role": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 32,
                  "pattern": "^[a-z]{1,32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "test_id": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "x": {
              "type": "number",
              "minimum": -10000000,
              "maximum": 10000000
            },
            "y": {
              "type": "number",
              "minimum": -10000000,
              "maximum": 10000000
            },
            "width": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000
            },
            "position": {
              "type": "string",
              "enum": [
                "static",
                "relative",
                "absolute",
                "fixed",
                "sticky"
              ]
            },
            "z_index": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "other": {
          "anyOf": [
            {
