      "properties": {
        "check": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
          "description": "Check identifier: layout.overlap, layout.spill, layout.page_h_scroll, layout.offscreen_control, layout.small_tap_target, layout.clipped_text, click.dead_click, click.rage_click, click.slow_feedback, click.silent_failure, click.error_after_click, stability.stuck_busy, stability.layout_shift, stability.slow_input, stability.broken_image or a11y.no_focus_indicator (added in 1.2.0: keyboard focus reached control_id and its outline, box shadow, border colours and background colour, and those of two ancestors, were the same focused and unfocused; evidence kind_focus is true)."
        },
        "check_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,64}$",
          "description": "Stable grouping key: SHA-256 (first 32 hex) of check, route_template, viewport width band and the elements' stable_id (or control_id); never coordinates, scroll offsets or text."
        },
        "route_template": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "pattern": "^/[A-Za-z0-9_\\-./:{}\\[\\]*()+@~]{0,255}$"
