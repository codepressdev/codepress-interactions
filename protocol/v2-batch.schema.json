                "test_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 128,
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stable_id": {
                  "type": "string",
                  "maxLength": 1024,
                  "pattern": "^[#*A-Za-z0-9_.:/-]{1,1024}$",
                  "description": "Identity used by the fingerprint: the test ID, or a structural tag path from the nearest ancestor with a test ID (#anchor/div/button), from the root, or after * when cut at 8 tags. Not unique: siblings with the same tags share a path."
                },
                "x": {
                  "type": "number",
                  "minimum": -10000000,
                  "maximum": 10000000
                },
                "y": {
                  "type": "number",
                  "minimum": -10000000,
                  "maximum": 10000000
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000000
                },
                "height": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000000
                },
                "position": {
                  "type": "string",
                  "enum": [
                    "static",
                    "relative",
                    "absolute",
                    "fixed",
                    "sticky"
                  ]
                },
                "z_index": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The element the finding is about; null when it has no element (click and performance findings without a matching snapshot row)."
        },
        "other": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "tag",
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
