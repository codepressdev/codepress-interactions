              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ],
          "description": "The clicked control's identifier, for click findings."
        },
        "evidence": {
          "type": "object",
          "description": "Measured facts only, never a verdict or text. Keys are snake_case measurement names, e.g. overlap_px, overlap_ratio, text_overlap_px, blocked_points, tested_points, clip_px, first_feedback_ms, same_stacking_context.",
          "maxProperties": 32,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,47}$": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": -1000000000,
                  "maximum": 1000000000
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "description": "A check matched: a pointer with measured evidence, never a verdict. The browser SDK runs the checks in idle time and sends each fingerprint once per page session; tests and services can run the same checks (@codepress/interactions-browser/detect) over stored snapshots and events."
