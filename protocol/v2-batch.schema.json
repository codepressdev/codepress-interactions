        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "ui.finding"
        },
        "attribution": {
          "type": "string",
          "enum": [
            "inferred",
            "unknown"
          ]
        },
        "data": {
          "$ref": "#/$defs/FindingData"
        }
      }
    },
    "PerfSummaryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "schema_version",
        "source",
        "source_instance_id",
        "sequence",
        "occurred_at",
        "type",
        "attribution",
        "data"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "const": 2
        },
        "interaction_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "browser",
