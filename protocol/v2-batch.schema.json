        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "perf.summary"
        },
        "attribution": {
          "const": "unknown"
        },
        "data": {
          "$ref": "#/$defs/PerfSummaryData"
        }
      }
    },
    "LegacyData": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "control_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "surface": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "route_template": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "pattern": "^/[A-Za-z0-9_\\-./:{}\\[\\]*()+@~]{0,255}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "feedback_type": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "running",
                "succeeded",
                "failed",
                "cancelled",
                "pending",
                "completed",
                "error",
                "abandoned"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "request_label": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_key": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "description": "interaction.started for a click: an opaque per-page-session number for the element clicked (the nearest control or label inside control_id, else the clicked element). Only equality is meaningful; rage_click groups by it. Absent before 0.3.0."
        }
      },
      "description": "v1 event data, unchanged except: sdk_version moved to the batch, request_label (a bounded label returned by the host's requestLabel callback) was added, and target_key was added in 0.3.0."
    },
    "SnapshotData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "trigger",
        "route_template",
        "viewport_width",
        "viewport_height",
        "element_count",
        "truncated",
        "torn",
        "bytes",
        "walk_ms",
        "slices",
        "max_slice_ms"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the uncompressed snapshot body bytes; the body is stored at /v2/snapshots/{sha256}."
        },
        "trigger": {
          "type": "string",
          "enum": [
            "route",
            "click",
            "resize",
            "visible",
            "manual",
            "hover",
            "focus"
          ],
          "description": "What took the snapshot. hover and focus (added in 1.2.0): an overlay opened after a resting pointer or keyboard focus (see ui.hover.settled)."
        },
        "route_template": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "pattern": "^/[A-Za-z0-9_\\-./:{}\\[\\]*()+@~]{0,255}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "viewport_width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "viewport_height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "element_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "truncated": {
          "type": "boolean"
        },
        "torn": {
          "type": "boolean"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "walk_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400000
        },
        "slices": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_slice_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400000
        },
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "unknown"
          ],
          "description": "Color scheme on screen, as in the body's viewport.theme. Absent before 0.3.0."
        }
      },
      "description": "A screen was captured. Sent once per distinct sha256 per page session."
    },
    "ClickSettledData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "control_id",
        "route_template",
        "first_feedback_ms",
        "settle_ms",
        "mutation_count",
        "request_count",
        "request_failed_count",
        "error_count",
        "long_task_count",
        "layout_shift_score",
        "route_changed",
        "dialog_opened",
        "focus_moved",
        "overlapped",
        "incomplete",
        "end_reason",
        "before_sha256",
        "after_sha256"
      ],
      "properties": {
        "action": {
          "const": "click"
        },
        "control_id": {
          "type": "string",
          "maxLength": 128
        },
        "route_template": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "pattern": "^/[A-Za-z0-9_\\-./:{}\\[\\]*()+@~]{0,255}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_feedback_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ],
          "description": "First DOM change, route change, dialog or focus move after the click; null when none was observed."
        },
        "settle_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400000,
          "description": "Time to the last observed effect when settled; otherwise time until the window ended."
        },
        "mutation_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "request_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "request_failed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "error_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "long_task_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when long tasks are unavailable in this browser."
        },
        "layout_shift_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when layout shifts are unavailable in this browser."
        },
        "route_changed": {
          "type": "boolean"
        },
        "dialog_opened": {
          "type": "boolean"
        },
        "focus_moved": {
          "type": "boolean"
        },
        "target_interactive": {
          "type": "boolean",
          "description": "The click landed on a control (button, link, form field, label, summary, control role or tabindex), not only inside a container. Absent before 0.3.0."
        },
        "value_changed": {
          "type": "boolean",
          "description": "An input or change event fired on the clicked field (checkbox, radio, select). Absent before 0.3.0."
        },
        "field_focused": {
          "type": "boolean",
          "description": "The click put focus in a text field, select or editable region; the caret or picker is its effect. Absent before 0.3.0."
        },
        "new_context": {
          "type": "boolean",
          "description": "The click opened a new tab or window (link target, modifier key, download or window.open). Absent before 0.3.0."
        },
        "selection_changed": {
          "type": "boolean",
          "description": "The click changed the text selection or moved the caret (a selectionchange from its own press or while it was open), for example selecting a word with a double-click. rage_click counts it as an answer. Absent before 1.0.0."
        },
        "overlapped": {
          "type": "boolean",
          "description": "Another click started before this one settled (on both clicks). Counts are never shared between them."
        },
        "incomplete": {
          "type": "boolean",
          "description": "The window ended by timeout or by the page being hidden/unloaded."
        },
        "end_reason": {
          "type": "string",
          "enum": [
            "settled",
            "overlapped",
            "timeout",
            "page_hidden"
          ]
        },
        "before_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "after_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "What followed a click until the page was quiet for clickSettleMs with no observed request in flight. Always attribution \"inferred\"; interaction_id is the click's interaction.started id. Requests in the window are counted here and never marked explicit."
    },
    "HoverSettledData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "control_id",
        "route_template",
        "dwell_ms",
        "settle_ms",
        "transition_started",
        "animation_started",
        "nodes_added",
        "overlay_opened",
        "expanded_changed",
        "class_changed",
        "style_changed",
        "snapshot_sha256",
        "has_hover_handler"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "pointer",
            "focus"
          ],
          "description": "pointer: a mouse or pen pointer (never touch) rested on the control for at least hoverDwellMs. focus: keyboard focus (:focus-visible) reached it."
        },
        "control_id": {
          "type": "string",
          "maxLength": 128,
          "description": "The hovered or focused control, identified as a click's control_id is (test ID, else a tag path)."
        },
        "route_template": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "pattern": "^/[A-Za-z0-9_\\-./:{}\\[\\]*()+@~]{0,255}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dwell_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400000,
          "description": "How long the pointer rested before the hover counted; 0 for focus."
        },
        "settle_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400000,
          "description": "Time from the pointer arriving (or focus) to the last observed effect."
        },
        "transition_started": {
          "type": "boolean",
          "description": "A CSS transition ran on the control, an ancestor, or inside what appeared."
        },
        "animation_started": {
          "type": "boolean",
          "description": "A CSS animation started on the control, an ancestor, or inside what appeared."
        },
        "nodes_added": {
          "type": "boolean",
          "description": "Elements were added anywhere in the observed root."
        },
        "overlay_opened": {
          "type": "boolean",
          "description": "A dialog, tooltip, menu, listbox or popover appeared (added, or shown by an attribute, class or style change, or a popover toggle)."
        },
        "expanded_changed": {
          "type": "boolean",
          "description": "An aria-expanded attribute changed."
        },
        "class_changed": {
          "type": "boolean",
          "description": "A class attribute changed on the control, an ancestor, or inside what appeared."
        },
        "style_changed": {
          "type": "boolean",
          "description": "An inline style changed on the control, an ancestor, or inside what appeared."
        },
        "snapshot_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "The snapshot taken after settling because an overlay opened (trigger hover or focus); null when none was taken."
        },
        "has_hover_handler": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "A React onMouseEnter, onMouseOver, onPointerEnter or onPointerOver handler on the control or up to 3 ancestors; false when they are React elements without one; null when none is a React element."
        }
      },
      "description": "Added in 1.2.0. What followed a resting mouse or pen pointer or a keyboard focus until the page was quiet for hoverSettleMs. Sent only when at least one effect boolean is true; hovers and focuses that changed nothing are counted in perf.summary (hovers_silent, focus_silent). At most one per kind, control and route every hoverRecordIntervalMs (default 30 s) and maxHoverRecordsPerMinute (default 30) per page. Always attribution \"unknown\" with a null interaction_id."
    },
    "FindingData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "check_version",
